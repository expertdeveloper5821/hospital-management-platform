# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI= "mongodb://localhost:27017/"

# JWT
JWT_SECRET=
JWT_EXPIRY=8h
INVITE_JWT_SECRET=
INVITE_JWT_EXPIRY=48h
RESET_TOKEN_EXPIRY=1h

# bcrypt
BCRYPT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
allowedOrigins=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Razorpay (Unit 5 — Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dashboard Analytics (E01)
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_POLL_INTERVAL_SECONDS=60

# Field-level encryption (AES-256-GCM) — base64-encoded 32-byte key used to
# encrypt Patient PII at rest (aadhaarNumber, dateOfBirth, bloodGroup, and the
# address block: address/addressLine1/addressLine2/city/state/country/pincode).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AADHAAR_ENCRYPTION_KEY=

# Base64-encoded 32-byte key used to encrypt clinical data at rest (OPD / IPD /
# Lab fields). Required — there is no fallback to AADHAAR_ENCRYPTION_KEY.
# Generate the same way as above. Once rows are encrypted under this key,
# changing it makes them undecryptable until they are re-encrypted.
MEDICAL_DATA_ENCRYPTION_KEY=

# Base64-encoded 32-byte key used to encrypt payment data at rest
# (Payment.description / .transactionId, Charge.description). Required — there
# is no fallback to AADHAAR_ENCRYPTION_KEY. Same rotation caveat as above.
PAYMENT_DATA_ENCRYPTION_KEY=

# Staff ID Card QR verification (optional at boot, but REQUIRED to generate a
# Staff ID Card). Stable public origin of the frontend that hosts /verify-staff —
# it is printed into every card's QR code, so changing it later breaks already
# printed cards. Must be https:// in production. Left commented out because
# dotenv-safe treats every uncommented key here as mandatory at startup.
# STAFF_VERIFY_BASE_URL=http://localhost:3001
# Per-IP limit for the public GET /api/public/staff-verification/:token route.
# STAFF_VERIFY_RATE_LIMIT_WINDOW_MS=900000
# STAFF_VERIFY_RATE_LIMIT_MAX=30
