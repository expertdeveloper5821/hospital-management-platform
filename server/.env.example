# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI= "mongodb://localhost:27017/"

# JWT
JWT_SECRET=
JWT_EXPIRY=8h
INVITE_JWT_SECRET=
INVITE_JWT_EXPIRY=48h
RESET_TOKEN_EXPIRY=1h

# bcrypt
BCRYPT_ROUNDS=12

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
allowedOrigins=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Razorpay (Unit 5 — Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dashboard Analytics (E01)
DASHBOARD_CACHE_TTL_SECONDS=60
DASHBOARD_POLL_INTERVAL_SECONDS=60

# Field-level encryption (AES-256-GCM) — base64-encoded 32-byte key used to
# encrypt Patient PII at rest (aadhaarNumber, dateOfBirth, bloodGroup, and the
# address block: address/addressLine1/addressLine2/city/state/country/pincode).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AADHAAR_ENCRYPTION_KEY=

# Base64-encoded 32-byte key used to encrypt clinical free-text at rest
# (OPDVisit.diagnosis / .prescription / .notes). Generate the same way as above.
# Deliberately left commented out: dotenv-safe treats every uncommented key
# here as required, and omitting it falls back to AADHAAR_ENCRYPTION_KEY so
# existing deployments keep running. Uncomment and set a distinct key —
# separate keys per data domain is the intended configuration. Set it BEFORE
# any clinical data is written: once rows are encrypted under one key, changing
# this value makes them undecryptable until they are re-encrypted.
# MEDICAL_DATA_ENCRYPTION_KEY=

# Base64-encoded 32-byte key used to encrypt payment free-text / reference
# numbers at rest (Payment.description / .transactionId). Same rules as
# MEDICAL_DATA_ENCRYPTION_KEY above — commented out so it is optional and falls
# back to AADHAAR_ENCRYPTION_KEY; uncomment and set a distinct key before any
# payment data is written.
# PAYMENT_DATA_ENCRYPTION_KEY=
